{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CompressorX",
  "version": "0.1.0",
  "identifier": "com.compressorx.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CompressorX - Video Compression Tool",
        "width": 500,
        "height": 650,
        "minWidth": 450,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "tauri-plugin-fs": {
      "fs": {
        "read": {
          "scope": ["**"]
        }
      }
    },
    "tauri-plugin-dialog": {
      "all": {
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/*"
    ],
    "category": "Utility",
    "shortDescription": "A desktop video compression tool",
    "longDescription": "CompressorX is a desktop application for compressing video files using FFmpeg",
    "copyright": "© 2025 CompressorX",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
